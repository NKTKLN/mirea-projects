_robot\nimport user_notice_2\n\n# generated\n# Опишите эту функцию…\ndef BuildExpenseRecord(employee_name, settlement_status, total_expense, advance_given):\n    log_process(window_log=True,block_text='Присвоить значение переменной')\n    #^#LsWaJQGF(pHQZp6.^]\n    difference_amount = math.fabs(total_expense - advance_given)\n\n    log_process(block_text='Присвоить значение переменной')\n\n    return {\n    'employee_name': employee_name,\n    'settlement_status': settlement_status,\n    'difference_amount': difference_amount\n}\n\n# Опишите эту функцию…\ndef CalculateTotalExpense(trip_days, daily_allowance, receipts_total):\n    log_process(window_log=True,block_text='Присвоить значение переменной')\n    #hfQkSo;K5,-;reVeFiyn\n    daily_expense = trip_days * daily_allowance\n\n    log_process(block_text='Присвоить значение переменной')\n\n    return daily_expense + receipts_total\n\n# Опишите эту функцию…\ndef DetermineSettlementStatus(total_expense, advance_given):\n    log_process(window_log=True,block_text='Присвоить значение переменной')\n    #*zzC[4V*`3@vbO$T:[`b\n    function_out = ''\n\n    log_process(block_text='Присвоить значение переменной')\n\n    log_process(window_log=True,block_text='Если – выполнить')\n    #z[1x|:.VX|i=waTgPMA0\n    if total_expense == advance_given:\n        log_process(window_log=True,block_text='Присвоить значение переменной')\n        #0vrUd8h4Fbl(x`y.:{b9\n        function_out = 'Расчёты погашены'\n\n        log_process(block_text='Присвоить значение переменной')\n\n    else:\n        log_process(window_log=True,block_text='Если – выполнить')\n        #nD}HS|jUb0MzX|t9]|cA\n        if total_expense > advance_given:\n            log_process(window_log=True,block_text='Присвоить значение переменной')\n            #/P2YT0#rQEK8nmQOq?H{\n            function_out = 'Доплата сотруднику'\n\n            log_process(block_text='Присвоить значение переменной')\n\n        else:\n            log_process(window_log=True,block_text='Если – выполнить')\n            #OkWl:t2h*C183OV}.~Y*\n            if total_expense < advance_given:\n                log_process(window_log=True,block_text='Присвоить значение переменной')\n                #a(s(heFQ3ehi0I%+D%yO\n                function_out = 'Возврат в кассу'\n\n                log_process(block_text='Присвоить значение переменной')\n\n\n            log_process(block_text='Если – выполнить')\n\n\n        log_process(block_text='Если – выполнить')\n\n\n    log_process(block_text='Если – выполнить')\n\n    return function_out\n\n\nlogger = configure_logger()\npuzzle_logger_path = Path(__file__).absolute()\nlogger.info(f'Старт робота: {puzzle_logger_path}')\n\nif __name__ == \"__main__\":\n    def main_nexus_647_proc():\n        try:\n            log_process(window_log=True,block_text='Присвоить значение переменной')\n            #;}Ca*?,smC/CVee4REZk\n            final_expense_list = []\n\n            log_process(block_text='Присвоить значение переменной')\n\n            # Присваивает переменной значение вставки\n            log_process(window_log=True,block_text='Присвоить значение переменной')\n            #j[dK2VeoCo4+nV[`akEI\n            fintech = read_file.read_json_file(None,'C:\\\\Users\\\\NKTKLN\\\\Desktop\\\\MIREA\\\\PoCS\\\\practice_5\\\\reports.json',block_text=\"Прочитать текст из json-файла\",window_log=True, current_language=\"ru\")\n\n            log_process(block_text='Присвоить значение переменной')\n\n            log_process(window_log=True,block_text='Цикл для каждого элемента')\n            #r35=F#ZK78el.mKzpGHi\n            for j in fintech:\n                log_process(window_log=True,block_text='Присвоить значение переменной')\n                #7/vZ+5;V-K8~OGT7n//+\n                total_expense = CalculateTotalExpense(j['trip_days'], j['daily_allowance'], j['receipts_total'])\n\n                log_process(block_text='Присвоить значение переменной')\n\n                log_process(window_log=True,block_text='Присвоить значение переменной')\n                #Yt!Tv(U|scSTwQ|S9_jY\n                settlement_status = DetermineSettlementStatus(total_expense, j['advance_given'])\n\n                log_process(block_text='Присвоить значение переменной')\n\n                log_process(window_log=True,block_text='Добавить элемент в список')\n                #.UU`)=7Aakuzu{/2Qoh%\n                final_expense_list.append((BuildExpenseRecord(j['employee_name'], settlement_status, total_expense, j['advance_given'])))\n\n                log_process(block_text='Добавить элемент в список')\n\n\n            log_process(block_text='Цикл для каждого элемента')\n\n            log_process(window_log=True,block_text='Если – выполнить')\n            #zvIcoI0SH6c=*B|-K}ni\n            if len(final_expense_list) != 6:\n                #T2_qlV*4/EZsMA!DKX#)\n                user_notice_2.user_notice('Длинна конечного списка не равна 6',None,block_text=\"Уведомление пользователя\",window_log=True, current_language=\"ru\")\n\n                #V=L@efYXCdRc0dx)QZ=y\n                stop_robot.stop_robot(logger, log_message_end='Завершение работы робота',block_text=\"Завершить работу\",window_log=True, current_language=\"ru\")\n\n\n            log_process(block_text='Если – выполнить')\n\n            #l7RV_2@UBnsI=Xco#.kz\n            files_and_folders.create_json('C:\\\\Users\\\\NKTKLN\\\\Desktop\\\\MIREA\\\\PoCS\\\\practice_5\\\\expense_result.json','utf-8',final_expense_list,block_text=\"Создать json-файл\",window_log=True, current_language=\"ru\")\n\n            #Y(=COY]V^-EqJM8^89Es\n            user_notice_2.user_notice(final_expense_list,None,block_text=\"Уведомление пользователя\",window_log=True, current_language=\"ru\")\n\n\n            logger.info(f'Завершение работы робота: {puzzle_logger_path}')\n            send_message_websocket(message_type=\"python_end\")\n        except Exception as error_puzzle:\n            logger.error(f'{puzzle_logger_path} ' + f'Ошибка: {error_puzzle}')\n            error_puzzle_format=format_traceback(error_puzzle)\n            send_message_websocket(message_type=\"python_error\", message=error_puzzle_format)\n            raise Exception(error_puzzle)\n    main_nexus_647_proc()","pId":"nexus_647"}
