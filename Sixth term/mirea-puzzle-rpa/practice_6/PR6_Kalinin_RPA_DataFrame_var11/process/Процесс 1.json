),block_text=\"Добавить столбец в dataframe\",window_log=True, current_language=\"ru\")\n            # Присваивает переменной значение вставки\n            log_process(window_log=True,block_text='Присвоить значение переменной')\n            #!A@qDl,p0ivmnJ0iJq%6\n            inventory_df = dataframes_tools.filter_dataframe(inventory_df,sheet_name_1=None,columns_operations=({\"columns_operations\":{\"column\":{\"0\":'quantity'},\"operation\":{\"0\":\"lt\"},\"value\":{\"0\":15},\"logic_operator\":{}}}),reset_index=\"FALSE\",write_to_db=\"FALSE\",engine=\"advanced\",block_text=\"Фильтровать табличные данные\",window_log=True, current_language=\"ru\")\n\n            log_process(block_text='Присвоить значение переменной')\n\n            #E(VQ),cb2.TbyTpnNfCU\n            write_excel.write_excel_2('C:\\\\Users\\\\NKTKLN\\\\Desktop\\\\MIREA\\\\PoCS\\\\practice_6\\\\low_stock.xlsx',inventory_df,'low_stock',block_text=\"Записать в Excel\",window_log=True, current_language=\"ru\")\n\n            #k0HA]!uZrQkf=!P~h{x?\n            user_notice_2.user_notice('Товары с низким остатком успешно сохранены в low_stock.xlsx!',None,block_text=\"Уведомление пользователя\",window_log=True, current_language=\"ru\")\n\n\n            logger.info(f'Завершение работы робота: {puzzle_logger_path}')\n            send_message_websocket(message_type=\"python_end\")\n        except Exception as error_puzzle:\n            logger.error(f'{puzzle_logger_path} ' + f'Ошибка: {error_puzzle}')\n            error_puzzle_format=format_traceback(error_puzzle)\n            send_message_websocket(message_type=\"python_error\", message=error_puzzle_format)\n            raise Exception(error_puzzle)\n    main_pilot_91_proc()","pId":"pilot_91"}
