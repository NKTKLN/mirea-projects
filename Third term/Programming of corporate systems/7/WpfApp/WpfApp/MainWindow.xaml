<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <!-- Стиль для ошибки -->
        <Style x:Key="ErrorStyle" TargetType="Label">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="DarkRed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для текстовых полей и меток -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5,0,50,5"/>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="LightSlateGray"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="5,0,50,0"/>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="LightBlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="Blue"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Поле "First Name" -->
        <Label Content="First Name:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="FirstNameBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>

        <!-- Поле "Last Name" -->
        <Label Content="Last Name:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="LastNameBox" Grid.Row="3" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>

        <!-- Поле "Email" -->
        <Label Content="Email:" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="EmailBox" Grid.Row="5" Grid.Column="0" Style="{StaticResource TextBoxStyle}"/>

        <!-- Поле "Password" -->
        <Label Content="Password:" Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
        <Grid Grid.Row="7" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="PasswordBox" Grid.Column="0" 
                         Style="{StaticResource PasswordBoxStyle}" 
                         ToolTip="Must be at least 7 characters" 
                         PasswordChanged="PasswordBox_PasswordChanged"/>
            <Label x:Name="PasswordErrorLabel" Content="Must be at least 7 characters" Grid.Column="1" 
                   Style="{StaticResource ErrorStyle}"/>
        </Grid>
        
        <!-- Поле "Confirm Password" -->
        <Label Content="Confirm Password:" Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
        <Grid Grid.Row="9" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <PasswordBox x:Name="ConfirmPasswordBox" Grid.Row="9" Grid.Column="0" 
                         Style="{StaticResource PasswordBoxStyle}"  
                         ToolTip="Must be at least 7 characters" 
                         PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
            <Label x:Name="ConfirmPasswordErrorLabel" Content="Must be at least 7 characters" Grid.Column="1" 
                   Style="{StaticResource ErrorStyle}"/>
        </Grid>
        
        <!-- Поле "Username" -->
        <Label Content="Username:" Grid.Row="0" Grid.Column="1" Style="{StaticResource LabelStyle}"/>
        <TextBox x:Name="Username" Grid.Row="1" Grid.Column="1" Style="{StaticResource TextBoxStyle}"/>

        <!-- Радиокнопки "Gender" -->
        <StackPanel Orientation="Vertical" Grid.Row="2" Grid.RowSpan="5" Grid.Column="1" Margin="5,0,50,0" VerticalAlignment="Center">
            <Grid VerticalAlignment="Center">
                <RadioButton GroupName="Gender" Margin="5">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3"/>
                    </RadioButton.LayoutTransform>
                </RadioButton>
                <Label Content="Female" VerticalAlignment="Center" Margin="50,0,0,0" FontSize="16"/>
            </Grid>
            <Grid VerticalAlignment="Center">
                <RadioButton GroupName="Gender" Margin="5" IsChecked="True">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3"/>
                    </RadioButton.LayoutTransform>
                </RadioButton>
                <Label Content="Male" VerticalAlignment="Center" Margin="50,0,0,0" FontSize="16"/>
            </Grid>
            <Grid VerticalAlignment="Center">
                <RadioButton GroupName="Gender" Margin="5">
                    <RadioButton.LayoutTransform>
                        <ScaleTransform ScaleX="3" ScaleY="3"/>
                    </RadioButton.LayoutTransform>
                </RadioButton>
                <Label Content="Rather not say" VerticalAlignment="Center" Margin="50,0,0,0" FontSize="16"/>
            </Grid>
        </StackPanel>

        <!-- Чекбокс Terms -->
        <Grid VerticalAlignment="Center" Grid.Row="7" Grid.Column="1" Margin="12,0,5,0">
            <CheckBox x:Name="TermsCheckBox">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="2.4" ScaleY="2.4"/>
                </CheckBox.LayoutTransform>
            </CheckBox>
            <TextBlock Text="By clicking Register, you accept Terms of Use and Privacy Policy." 
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="45,0,0,0" FontSize="15"/>
        </Grid>

        <!-- Кнопка Register -->
        <Button Content="Register" Grid.Row="9" Grid.Column="1" Width="125" Margin="5,0,50,0" 
                Style="{StaticResource LightBlueButtonStyle}" x:Name="RegisterButton_Click"/>
    </Grid>
</Window>
