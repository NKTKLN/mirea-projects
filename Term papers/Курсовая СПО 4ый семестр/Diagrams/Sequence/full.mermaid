sequenceDiagram
    participant Guest as Незарегистрированный пользователь
    participant Buyer as Покупатель
    participant Seller as Продавец
    participant Admin as Администратор
    participant System as Система
    participant DB as База данных

    %% Гость: просмотр цветов, регистрация и вход
    rect rgb(235, 245, 255)
        Guest->>System: Открыть главную страницу с каталогом цветов
        System->>DB: Запросить список цветов с фильтрами
        DB-->>System: Вернуть список цветов
        System-->>Guest: Показать каталог цветов с фильтрами

        Guest->>System: Выбрать цветок для просмотра подробностей
        System->>DB: Получить данные о выбранном цветке и поставщиках
        DB-->>System: Вернуть подробную информацию
        System-->>Guest: Отобразить страницу с описанием цветка и контактами поставщиков

        Guest->>System: Перейти на страницу регистрации
        Guest->>System: Ввести email, пароль, имя, фамилию, выбрать роль (Покупатель/Продавец)
        System->>System: Проверить корректность email и длину пароля
        alt Некорректные данные
            System-->>Guest: Показать сообщение об ошибке
        else Данные корректны
            System->>DB: Создать нового пользователя
            DB-->>System: Подтверждение создания
            System-->>Guest: Перенаправить на страницу входа
        end

        Guest->>System: Ввести email и пароль для входа
        System->>DB: Проверить учетные данные
        alt Неверный email или пароль
            System-->>Guest: Показать ошибку входа
        else Успешный вход
            System-->>Guest: Перенаправить на главную страницу с учетом роли
        end
    end

    %% Покупатель: управление корзиной и заказами
    rect rgb(230, 255, 230)
        Buyer->>System: Открыть главную страницу с каталогом цветов
        System->>DB: Получить список доступных цветов
        DB-->>System: Вернуть список цветов
        System-->>Buyer: Отобразить каталог с кнопками "Добавить в корзину"

        Buyer->>System: Добавить выбранный цветок в корзину (указать количество)
        System->>DB: Обновить содержимое корзины пользователя
        DB-->>System: Подтверждение обновления
        System-->>Buyer: Обновить отображение корзины

        Buyer->>System: Открыть страницу корзины
        System->>DB: Получить текущие товары в корзине
        DB-->>System: Вернуть товары корзины
        System-->>Buyer: Показать корзину с товарами и возможностью изменения количества

        Buyer->>System: Изменить количество товара в корзине (увеличить/уменьшить)
        System->>DB: Обновить количество товара
        DB-->>System: Подтверждение
        System-->>Buyer: Обновить корзину

        Buyer->>System: Очистить корзину
        System->>DB: Удалить все товары из корзины
        DB-->>System: Подтверждение очистки
        System-->>Buyer: Отобразить пустую корзину

        Buyer->>System: Оформить заказ
        System->>DB: Создать новый заказ на основе содержимого корзины
        System->>DB: Очистить корзину
        DB-->>System: Подтверждение
        System-->>Buyer: Показать список оформленных заказов

        Buyer->>System: Перейти на страницу заказов
        System->>DB: Получить список заказов пользователя
        DB-->>System: Вернуть список заказов
        System-->>Buyer: Отобразить заказы

        Buyer->>System: Выбрать заказ для просмотра деталей
        System->>DB: Получить подробности заказа
        DB-->>System: Вернуть детали заказа
        System-->>Buyer: Показать подробную информацию о заказе
    end

    %% Продавец: управление товарами и заказами
    rect rgb(255, 245, 230)
        Seller->>System: Открыть главную страницу с каталогом цветов (с возможностью редактирования своих товаров)
        System->>DB: Получить список всех цветов и отметить товары продавца
        DB-->>System: Вернуть список товаров с метками
        System-->>Seller: Отобразить каталог с кнопками "Редактировать" и "Удалить" для своих товаров

        Seller->>System: Перейти на страницу добавления нового цветка
        Seller->>System: Ввести параметры цветка (название, тип, место посадки, сезон, страна, цена)
        System->>DB: Сохранить новый цветок с привязкой к продавцу
        DB-->>System: Подтверждение сохранения
        System-->>Seller: Обновить список товаров

        Seller->>System: Отредактировать данные своего цветка
        System->>DB: Обновить информацию о цветке
        DB-->>System: Подтверждение обновления
        System-->>Seller: Обновить каталог

        Seller->>System: Удалить свой товар из каталога
        System->>DB: Удалить цветок
        DB-->>System: Подтверждение удаления
        System-->>Seller: Обновить каталог

        Seller->>System: Открыть страницу заказов, связанных с его товарами
        System->>DB: Получить список заказов с товарами продавца
        DB-->>System: Вернуть заказы
        System-->>Seller: Показать список заказов

        Seller->>System: Выбрать заказ для просмотра деталей
        System->>DB: Получить подробную информацию по заказу
        DB-->>System: Вернуть детали
        System-->>Seller: Отобразить детали заказа
    end

    %% Администратор: управление пользователями, товарами и заказами
    rect rgb(255, 230, 230)
        Admin->>System: Открыть главную страницу с полным каталогом товаров
        System->>DB: Получить все товары всех продавцов
        DB-->>System: Вернуть список товаров
        System-->>Admin: Отобразить каталог с кнопками редактирования и удаления

        Admin->>System: Редактировать или удалять любой товар
        System->>DB: Обновить или удалить товар
        DB-->>System: Подтверждение действия
        System-->>Admin: Обновить каталог

        Admin->>System: Открыть страницу всех заказов
        System->>DB: Получить список всех заказов
        DB-->>System: Вернуть заказы
        System-->>Admin: Показать список заказов

        Admin->>System: Выбрать заказ для просмотра подробностей
        System->>DB: Получить детальную информацию о заказе
        DB-->>System: Вернуть детали заказа
        System-->>Admin: Отобразить подробности заказа

        Admin->>System: Открыть управление пользователями
        System->>DB: Получить список всех пользователей
        DB-->>System: Вернуть список пользователей
        System-->>Admin: Показать список пользователей

        Admin->>System: Создать, изменить или удалить пользователя
        System->>DB: Выполнить создание, обновление или удаление
        DB-->>System: Подтверждение действия
        System-->>Admin: Обновить список пользователей
    end

