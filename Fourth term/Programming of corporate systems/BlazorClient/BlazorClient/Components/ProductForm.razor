@using BlazorClient.Shared
<div class="card p-3">
    <form @onsubmit="Save">
        <div class="form-group">
            <label>Название</label>
            <input class="form-control" @bind-value="Product.Name" required />
        </div>
        <div class="form-group">
            <label>Цена</label>
            <input type="number" class="form-control" @bind-value="Product.Price" step="0.01" required />
        </div>
        <div class="form-group">
            <label>Описание</label>
            <input class="form-control" @bind-value="Product.Description"></input>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-success">Сохранить</button>
            <button type="button" class="btn btn-secondary" @onclick="OnCancel">Отмена</button>
        </div>
    </form>
</div>

@code {
    [Parameter] public Product Product { get; set; } = new();
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Save()
    {
        await OnSave.InvokeAsync();
    }
}