@page "/"
@using BlazorClient.Components
@using BlazorClient.Services
@using BlazorClient.Shared
@inject ProductService ProductService
@inject NavigationManager Navigation

<h3>Список товаров</h3>

<button class="btn btn-primary my-2" @onclick="GoToAddProduct">Добавить товар</button>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Название</th>
            <th>Цена</th>
            <th>Описание</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Description</td>
                <td>
                    <button class="btn btn-warning" @onclick="() => GoToEditProduct(product.Id)">Редактировать</button>
                    <button class="btn btn-danger" @onclick="() => ShowDeleteConfirmation(product.Id)">Удалить</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<ConfirmationDialog @ref="confirmationDialog" OnConfirm="DeleteProductConfirmed" />

@code {
    private void GoToAddProduct()
    {
        Navigation.NavigateTo("/add-product");
    }

    private void GoToEditProduct(int productId)
    {
        Navigation.NavigateTo($"/edit-product/{productId}");
    }

    private List<Product> products = new();
    private ConfirmationDialog? confirmationDialog;
    private int productIdToDelete;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetProducts();
    }

    private void ShowDeleteConfirmation(int productId)
    {
        productIdToDelete = productId;
        confirmationDialog?.Show();
    }

    private async Task DeleteProductConfirmed()
    {
        await ProductService.DeleteProduct(productIdToDelete);
        products = await ProductService.GetProducts();
        StateHasChanged();
        confirmationDialog?.Cancel();
    }
}