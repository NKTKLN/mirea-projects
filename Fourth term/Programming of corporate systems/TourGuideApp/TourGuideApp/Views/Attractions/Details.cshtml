@model TourGuideApp.Models.Attraction

@{
    ViewData["Title"] = Model?.Name;
}

<div class="container mt-4">
    <h2 class="mb-4">@Model?.Name</h2>

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Описание:</dt>
                <dd class="col-sm-8">@Model?.Description</dd>

                <dt class="col-sm-4">История:</dt>
                <dd class="col-sm-8">@Model?.History</dd>

                <dt class="col-sm-4">Часы работы:</dt>
                <dd class="col-sm-8">@Model?.WorkingHours</dd>

                <dt class="col-sm-4">Стоимость входа:</dt>
                <dd class="col-sm-8">
                    @(Model.EntranceFee.HasValue ? $"{Model.EntranceFee:C}" : "Бесплатно")
                </dd>

                <dt class="col-sm-4">Город:</dt>
                <dd class="col-sm-8">
                    <a asp-controller="Cities" asp-action="Details" asp-route-id="@Model?.CityId">
                        @Model?.City?.Name
                    </a>
                </dd>
            </dl>
        </div>

        <div class="col-md-6 text-center">
            @if (!string.IsNullOrEmpty(Model?.PhotoPath))
            {
                <img src="@Model.PhotoPath" alt="Фото достопримечательности" class="img-fluid rounded shadow-sm" />
            }
            else
            {
                <p>Фото отсутствует</p>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Cities" asp-action="Details" asp-route-id="@Model?.CityId" class="btn btn-outline-secondary">
            &larr; Назад к городу
        </a>
    </div>
</div>