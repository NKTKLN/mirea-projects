<Window x:Class="LibraryApp.Windows.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp.Windows"
        mc:Ignorable="d"
        Title="AddBookWindow" Height="360" Width="350">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Название:"/>
        <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,5"/>

        <TextBlock Text="Автор:" Grid.Row="2"/>
        <ComboBox x:Name="AuthorComboBox" Grid.Row="3" Margin="0,5" SelectedValuePath="Id"/>

        <TextBlock Text="Жанр:" Grid.Row="4"/>
        <ComboBox x:Name="GenreComboBox" Grid.Row="5" Margin="0,5" SelectedValuePath="Id"/>

        <TextBlock Text="Год публикации:" Grid.Row="6"/>
        <TextBox x:Name="YearTextBox" Grid.Row="7" Margin="0,5"/>

        <TextBlock Text="ISBN:" Grid.Row="8"/>
        <TextBox x:Name="ISBNTextBox" Grid.Row="9" Margin="0,5"/>

        <TextBlock Text="Количество в наличии:" Grid.Row="10"/>
        <TextBox x:Name="QuantityTextBox" Grid.Row="11" Margin="0,5"/>

        <StackPanel Orientation="Horizontal" Grid.Row="12" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" Click="AddBook_Click" Width="100"/>
            <Button Content="Отмена" Click="Cancel_Click" Width="100" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
