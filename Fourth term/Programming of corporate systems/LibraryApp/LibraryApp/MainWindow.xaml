<Window x:Class="LibraryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="830">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск по названию:" Margin="0,0,10,0"/>
            <TextBox x:Name="SearchTextBox" Width="200" Margin="0,0,10,0" TextChanged="FilterChanged"/>

            <TextBlock Text="Фильтрация:" Margin="0,0,10,0"/>
            <ComboBox x:Name="AuthorFilter" Width="150" Margin="0,0,10,0" SelectionChanged="FilterChanged"/>
            <ComboBox x:Name="GenreFilter" Width="150" Margin="0,0,10,0" SelectionChanged="FilterChanged"/>
        </StackPanel>

        <DataGrid x:Name="BooksDataGrid" Grid.Row="1" AutoGenerateColumns="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="150"/>
                <DataGridTextColumn Header="Автор" Binding="{Binding AuthorName}" Width="150"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding GenreName}" Width="100"/>
                <DataGridTextColumn Header="Год" Binding="{Binding PublishYear}" Width="80"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120"/>
                <DataGridTextColumn Header="В наличии" Binding="{Binding QuantityInStock}" Width="100"/>

                <DataGridTemplateColumn Header="Действия" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✏" Click="EditBook_Click" Tag="{Binding Id}" Width="30" Margin="5,0,0,0"/>
                                <Button Content="🗑" Click="DeleteBook_Click" Tag="{Binding Id}" Width="30" Margin="5,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Список жанров" Click="OpenGenres_Click" Width="120"/>
            <Button Content="Список авторов" Click="OpenAuthors_Click" Width="120" Margin="10,0,0,0"/>
            <Button Content="Добавить книгу" Click="AddBook_Click" Width="150" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
