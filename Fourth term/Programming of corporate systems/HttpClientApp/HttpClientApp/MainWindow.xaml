<Window x:Class="HttpClientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        Title="HTTP Клиент" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <emoji:TextBlock Text="🌐 URL:"  VerticalAlignment="Center" FontWeight="Bold" Margin="5"/>
            <TextBox x:Name="UrlInput" Width="300" VerticalAlignment="Center" Margin="5" Text="http://localhost:5000"/>
            <ComboBox x:Name="MethodSelector" Width="100" Margin="5" SelectedIndex="0">
                <ComboBoxItem>
                    <emoji:TextBlock Text="GET ✋"/>
                </ComboBoxItem>
                <ComboBoxItem>
                    <emoji:TextBlock Text="POST 📝"/>
                </ComboBoxItem>
            </ComboBox>
            <Button x:Name="SendRequestButton" Click="SendRequestButton_Click" Margin="5">
                <emoji:TextBlock Text="Отправить запрос ✉️" FontSize="14"/>
            </Button>
        </StackPanel>

        <GroupBox Header="Тело запроса (JSON)" Grid.Row="1" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="RequestBodyInput" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap" Margin="5"/>

                <GroupBox Header="Ответ от сервера 📤" Grid.Row="2" Margin="10">
                    <ScrollViewer>
                        <emoji:TextBlock x:Name="ResponseOutput" TextWrapping="Wrap" />
                    </ScrollViewer>
                </GroupBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>